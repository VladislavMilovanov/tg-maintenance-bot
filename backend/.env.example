# Backend runtime
BACKEND_APP_ENV=dev
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
BACKEND_LOG_LEVEL=INFO
BACKEND_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tg_maintenance

# LLM integration
BACKEND_OPENROUTER_API_KEY=
BACKEND_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
BACKEND_OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
BACKEND_OPENROUTER_TIMEOUT_SECONDS=20
BACKEND_OPENROUTER_SYSTEM_PROMPT=Ты помощник по мониторингу оборудования. Отвечай кратко, по-русски, опираясь только на переданный контекст и не выдумывай факты.

# Assistant state
BACKEND_CONVERSATION_TTL_SECONDS=1800
BACKEND_SEED_EQUIPMENT_IDS=["eq-1","eq-42"]
